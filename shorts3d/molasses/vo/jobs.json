[
 {
  "out": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/n01.wav",
  "text": "He heard the giant tank groan every night, and told his boss: one day, this thing is going to burst and drown the whole street.",
  "ref": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/narrator.wav",
  "exag": 0.6,
  "cfg": 0.45
 },
 {
  "out": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/n02.wav",
  "text": "The whole street burst out laughing.",
  "ref": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/narrator.wav",
  "exag": 0.6,
  "cfg": 0.45
 },
 {
  "out": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/n03.wav",
  "text": "You see, it was the biggest tank in Boston. Fifteen metres tall, and full of nearly nine million litres of sticky molasses.",
  "ref": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/narrator.wav",
  "exag": 0.6,
  "cfg": 0.45
 },
 {
  "out": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/n04.wav",
  "text": "When it started leaking, the boss had a better idea. He painted the tank brown, so nobody could see the leaks.",
  "ref": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/narrator.wav",
  "exag": 0.6,
  "cfg": 0.45
 },
 {
  "out": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/n05.wav",
  "text": "And the neighbourhood kids ran over with cups to catch the free syrup.",
  "ref": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/narrator.wav",
  "exag": 0.6,
  "cfg": 0.45
 },
 {
  "out": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/n06.wav",
  "text": "Then he found a crack running down the side. He showed everyone. Nothing happened.",
  "ref": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/narrator.wav",
  "exag": 0.6,
  "cfg": 0.45
 },
 {
  "out": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/n07.wav",
  "text": "Now they laughed even harder.",
  "ref": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/narrator.wav",
  "exag": 0.6,
  "cfg": 0.45
 },
 {
  "out": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/b01.wav",
  "text": "Relax! It's syrup, not dynamite!",
  "ref": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/hale.wav",
  "exag": 0.75,
  "cfg": 0.4
 },
 {
  "out": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/n08.wav",
  "text": "Then a ship pumped in a fresh load, and one January morning, the air turned warm. The tank groaned louder than ever.",
  "ref": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/narrator.wav",
  "exag": 0.6,
  "cfg": 0.45
 },
 {
  "out": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/n09.wav",
  "text": "He ran down the street, shouting at everyone to get away from the tank.",
  "ref": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/narrator.wav",
  "exag": 0.6,
  "cfg": 0.45
 },
 {
  "out": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/w01.wav",
  "text": "Ha! Scared of pancakes, are we?",
  "ref": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/dad.wav",
  "exag": 0.8,
  "cfg": 0.35
 },
 {
  "out": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/n10.wav",
  "text": "The workers laughed and sat down for lunch.",
  "ref": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/narrator.wav",
  "exag": 0.6,
  "cfg": 0.45
 },
 {
  "out": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/n11.wav",
  "text": "Minutes later, rivets shot out like bullets, the tank split open, and a wave of molasses eight metres high roared down the street.",
  "ref": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/narrator.wav",
  "exag": 0.6,
  "cfg": 0.45
 },
 {
  "out": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/n12.wav",
  "text": "It knocked houses off their foundations and bent the train tracks. Twenty-one people never got out.",
  "ref": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/narrator.wav",
  "exag": 0.6,
  "cfg": 0.45
 },
 {
  "out": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/n13.wav",
  "text": "Nobody had ever tested the tank. Not even with water. Its steel was too thin for that much weight.",
  "ref": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/narrator.wav",
  "exag": 0.6,
  "cfg": 0.45
 },
 {
  "out": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/n14.wav",
  "text": "And as the molasses cooled in the winter air, it turned thick as glue, trapping everyone it caught.",
  "ref": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/narrator.wav",
  "exag": 0.6,
  "cfg": 0.45
 },
 {
  "out": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/n15.wav",
  "text": "The brown paint never stopped a single leak. It only hid the warning.",
  "ref": "/home/rasul/Desktop/Animations/shorts3d/molasses/vo/narrator.wav",
  "exag": 0.6,
  "cfg": 0.45
 }
